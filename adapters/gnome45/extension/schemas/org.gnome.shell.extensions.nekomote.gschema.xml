<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="org.gnome.shell.extensions.nekomote" path="/org/gnome/shell/extensions/nekomote/">
    <key name="assets-dir" type="s">
      <default>''</default>
      <summary>Absolute NekoMote assets directory</summary>
    </key>
    <key name="renderer-path" type="s">
      <default>''</default>
      <summary>Absolute renderer executable path, or empty to use the default</summary>
    </key>
    <key name="backend" type="s">
      <choices>
        <choice value="opengl"/>
        <choice value="vulkan"/>
      </choices>
      <default>'opengl'</default>
      <summary>NekoMote rendering backend</summary>
    </key>
  </schema>
</schemalist>
