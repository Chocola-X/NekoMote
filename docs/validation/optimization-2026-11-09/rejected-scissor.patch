+TEST_CASE("Protected composite bounds retain fractional edges and empty target policies",
+          "[gpu][vulkan]")
+{
+    Fixture f;
+    f.upload(TextureId{1}, {1, 1, {255, 0, 0, 255}});
+    const auto vertices = quad(8, 12, 24, 36);
+    const std::array<DrawCommand, 1> commands{{{TextureId{1}, 0, 6, BlendMode::Over}}};
+    const RenderFrame frame{vertices, std::span(kIndices).first(6), commands,
+                            ColorComposition::ProtectedStraight};
+    for (const auto view : {render_vk::View{0, 0, 1, {0, 0, 1, 1}},
+                            render_vk::View{3.25f, -2.25f, 1.5f, {0, 0, 1, 1}, 1, true},
+                            render_vk::View{-150, 0, 1, {0, 0, 1, 1}}})
+    {
+        f.draw(frame, view);
+        const auto images = f.capture();
+        require_same_picture(images);
+        float left = 8 * view.scale + view.origin_x;
+        float right = 24 * view.scale + view.origin_x;
+        if (view.flip_x)
+        {
+            const float old_left = left;
+            left = 64 - right;
+            right = 64 - old_left;
+        }
+        const float top = 12 * view.scale + view.origin_y;
+        const float bottom = 36 * view.scale + view.origin_y;
+        for (const auto* image : {&images.first, &images.second})
+            for (int y = 0; y < 64; ++y)
+                for (int x = 0; x < 64; ++x)
+                {
+                    const bool inside = static_cast<float>(x) + .5f >= left &&
+                                        static_cast<float>(x) + .5f < right &&
+                                        static_cast<float>(y) + .5f >= top &&
+                                        static_cast<float>(y) + .5f < bottom;
+                    REQUIRE(pixel(*image, x, y) ==
+                            (inside ? std::array<std::uint8_t, 4>{255, 0, 0, 255}
+                                    : std::array<std::uint8_t, 4>{0, 0, 255, 255}));
+                }
+        const RenderFrame empty{{}, {}, {}, ColorComposition::ProtectedStraight};
+        f.draw(empty, view, 64, 64, render_vk::TargetContents::Preserve);
+        const auto preserved = f.capture();
+        REQUIRE(preserved.first.pixels == images.first.pixels);
+        REQUIRE(preserved.second.pixels == images.second.pixels);
+        f.draw(empty, view);
+        const auto cleared = f.capture();
+        for (const auto* image : {&cleared.first, &cleared.second})
+            REQUIRE(pixel(*image, 16, 20) == std::array<std::uint8_t, 4>{0, 0, 255, 255});
+    }
+}
