{
    "version": 6,
    "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            }
        },
        {
            "name": "dev",
            "inherits": "base",
            "displayName": "Debug with warnings-as-errors",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "NEKOMOTE_WERROR": "ON",
                "NEKOMOTE_BUILD_PREVIEW": "ON",
                "NEKOMOTE_BUILD_TESTS": "ON"
            }
        },
        {
            "name": "release",
            "inherits": "base",
            "displayName": "Release with LTO",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "NEKOMOTE_WERROR": "ON",
                "NEKOMOTE_BUILD_PREVIEW": "ON",
                "NEKOMOTE_BUILD_TESTS": "ON",
                "CMAKE_INTERPROCEDURAL_OPTIMIZATION": "ON"
            }
        },
        {
            "name": "asan",
            "inherits": "base",
            "displayName": "Debug with AddressSanitizer + UBSan",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "NEKOMOTE_ENABLE_ASAN": "ON",
                "NEKOMOTE_WERROR": "ON",
                "NEKOMOTE_BUILD_PREVIEW": "ON",
                "NEKOMOTE_BUILD_PLAYER": "OFF",
                "NEKOMOTE_BUILD_TESTS": "ON"
            }
        }
    ],
    "buildPresets": [
        { "name": "dev",     "configurePreset": "dev" },
        { "name": "release", "configurePreset": "release" },
        { "name": "asan",    "configurePreset": "asan" }
    ],
    "testPresets": [
        {
            "name": "dev",
            "configurePreset": "dev",
            "output": { "outputOnFailure": true },
            "execution": { "noTestsAction": "error", "stopOnFailure": false }
        },
        {
            "name": "release",
            "configurePreset": "release",
            "output": { "outputOnFailure": true },
            "execution": { "noTestsAction": "error", "stopOnFailure": false }
        },
        {
            "name": "asan",
            "configurePreset": "asan",
            "output": { "outputOnFailure": true },
            "execution": { "noTestsAction": "error", "stopOnFailure": false }
        }
    ]
}
