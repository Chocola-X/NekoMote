{
    "version": 6,
    "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            }
        },
        {
            "name": "dev",
            "inherits": "base",
            "displayName": "Debug with warnings-as-errors",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "NEKOMOTE_WERROR": "ON",
                "NEKOMOTE_BUILD_PREVIEW": "ON",
                "NEKOMOTE_BUILD_TESTS": "ON"
            }
        },
        {
            "name": "release",
            "inherits": "base",
            "displayName": "Release with LTO",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "NEKOMOTE_WERROR": "ON",
                "NEKOMOTE_BUILD_PREVIEW": "ON",
                "NEKOMOTE_BUILD_TESTS": "ON",
                "CMAKE_INTERPROCEDURAL_OPTIMIZATION": "ON"
            }
        },
        {
            "name": "qt-quick",
            "inherits": "release",
            "displayName": "Isolated Qt Quick OpenGL host",
            "cacheVariables": {
                "NEKOMOTE_BUILD_QT_QUICK": "ON"
            }
        },
        {
            "name": "plasma",
            "inherits": "release",
            "displayName": "Plasma wallpaper QML module and probe",
            "cacheVariables": {
                "NEKOMOTE_BUILD_QT_QUICK": "ON",
                "NEKOMOTE_BUILD_PLASMA": "ON",
                "NEKOMOTE_BUILD_VULKAN": "ON"
            }
        },
        {
            "name": "asan",
            "inherits": "base",
            "displayName": "Debug with AddressSanitizer + UBSan",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "NEKOMOTE_ENABLE_ASAN": "ON",
                "NEKOMOTE_BUILD_QT_QUICK": "OFF",
                "NEKOMOTE_WERROR": "ON",
                "NEKOMOTE_BUILD_PREVIEW": "OFF",
                "NEKOMOTE_BUILD_ABI": "ON",
                "NEKOMOTE_BUILD_PLAYER": "OFF",
                "NEKOMOTE_BUILD_TESTS": "ON"
            }
        },
        {
            "name": "vulkan",
            "inherits": "dev",
            "displayName": "Debug with Vulkan backend",
            "cacheVariables": {
                "NEKOMOTE_BUILD_VULKAN": "ON"
            }
        },
        {
            "name": "vulkan-release",
            "inherits": "release",
            "displayName": "Release with OpenGL and Vulkan 1.0 backends",
            "cacheVariables": {
                "NEKOMOTE_BUILD_VULKAN": "ON"
            }
        }
    ],
    "buildPresets": [
        { "name": "dev",     "configurePreset": "dev" },
        { "name": "release", "configurePreset": "release" },
        { "name": "asan",    "configurePreset": "asan" },
        { "name": "qt-quick", "configurePreset": "qt-quick" },
        { "name": "plasma",   "configurePreset": "plasma" },
        { "name": "vulkan",   "configurePreset": "vulkan" },
        { "name": "vulkan-release", "configurePreset": "vulkan-release" }
    ],
    "testPresets": [
        {
            "name": "dev",
            "configurePreset": "dev",
            "output": { "outputOnFailure": true },
            "execution": { "noTestsAction": "error", "stopOnFailure": false }
        },
        {
            "name": "release",
            "configurePreset": "release",
            "output": { "outputOnFailure": true },
            "execution": { "noTestsAction": "error", "stopOnFailure": false }
        },
        {
            "name": "asan",
            "configurePreset": "asan",
            "output": { "outputOnFailure": true },
            "execution": { "noTestsAction": "error", "stopOnFailure": false }
        },
        {
            "name": "plasma",
            "configurePreset": "plasma",
            "output": { "outputOnFailure": true },
            "execution": { "noTestsAction": "error", "stopOnFailure": false }
        },
        {
            "name": "vulkan",
            "configurePreset": "vulkan",
            "output": { "outputOnFailure": true },
            "execution": { "noTestsAction": "error", "stopOnFailure": false, "jobs": 1 }
        },
        {
            "name": "vulkan-release",
            "configurePreset": "vulkan-release",
            "output": { "outputOnFailure": true },
            "execution": { "noTestsAction": "error", "stopOnFailure": false, "jobs": 1 }
        }
    ]
}
